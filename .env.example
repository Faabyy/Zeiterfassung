# Vorlage für die lokale Konfiguration: cp .env.example .env
# Die .env selbst wird nicht eingecheckt.

# Postgres
POSTGRES_DB=zeiterfassung
POSTGRES_USER=zeiterfassung
POSTGRES_PASSWORD=zeiterfassung
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000

# Benutzer für die Anmeldung (keine Registrierung), name:passwort mit Komma
# getrennt. Wer hier entfernt wird, kann sich nicht mehr anmelden; seine
# Buchungen bleiben erhalten.
APP_USERS=azubi:azubi,demo:demo
